# Şablon dosya — gerçek anahtarları .env'e yaz, bu dosyaya değil.
# `cp .env.example .env` yap, sonra .env'i doldur.

# ===== LLM APIs =====
ANTHROPIC_API_KEY=
AI_GATEWAY_API_KEY=
OPENAI_API_KEY=
GOOGLE_API_KEY=

# ===== Finansal veri sağlayıcıları =====
FINNHUB_API_KEY=
ALPHA_VANTAGE_API_KEY=
NEWSAPI_KEY=
POLYGON_API_KEY=
FRED_API_KEY=

# ===== Storage =====
DATABASE_URL=duckdb:///./backend/data/finllm.duckdb

# ===== Portfolio =====
# Sistemin "varsaydığı" toplam sermaye. Pozisyon yüzdeleri buna göre hesaplanır.
PORTFOLIO_INITIAL_CAPITAL_USD=10000

# ===== Runtime =====
LOG_LEVEL=INFO
ENV=development
TCMB_API_KEY=
