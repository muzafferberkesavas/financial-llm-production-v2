# FinLLM AWS EC2 deployment env vars
# Kullanım: cp .env.example .env && nano .env

# ---- Domain (Caddy auto-SSL) ----
# Kendi domain'in varsa: api.finllm.app
# Yoksa: <eip-tireli>.nip.io (örn. 13-50-99-239.nip.io)
DOMAIN=

# ---- Postgres ----
POSTGRES_USER=finllm
POSTGRES_PASSWORD=
POSTGRES_DB=finllm

# ---- Anthropic / Claude ----
ANTHROPIC_API_KEY=

# ---- Finnhub (NASDAQ haberleri için, opsiyonel) ----
FINNHUB_API_KEY=

# ---- Telegram (kanal yayını + DM bot, opsiyonel) ----
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHANNEL_NASDAQ=
TELEGRAM_CHANNEL_BIST=

# ---- API auth (Vercel ile paylaşılan secret) ----
# Üret: openssl rand -hex 32
API_BEARER_TOKEN=

# ---- Ortam ----
ENV=production
PUBLIC_READ=true
