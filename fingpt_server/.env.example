# FinGPT sunucu yapılandırması (AWS EC2'de .env olarak yer alacak)
FINGPT_API_KEY=                       # backend ile paylaşılan secret (Bearer auth)
DEVICE=auto                            # auto | cuda | cpu
LOAD_IN_4BIT=true                      # GPU varsa 4-bit quantization (RAM tasarrufu)
SENTIMENT_MODEL=FinGPT/fingpt-mt_llama2-7b_lora
FORECASTER_MODEL=FinGPT/fingpt-forecaster_dow30_llama2-7b_lora
BASE_LLAMA_MODEL=meta-llama/Llama-2-7b-chat-hf
HF_TOKEN=                              # Llama-2 için HuggingFace token gerekli
RAG_INDEX_DIR=/opt/fingpt/rag_index
LOG_LEVEL=INFO
